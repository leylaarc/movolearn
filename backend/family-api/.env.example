# Copy to .env and fill before production.
# Never commit real secrets. Never put these values in the iOS app.

FAMILY_API_ENV=development
FAMILY_API_SECRET_KEY=replace-with-a-long-random-string
FAMILY_API_DATABASE_URL=sqlite:///./data/family.db
# Production example:
# FAMILY_API_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/movolearn
FAMILY_API_ACCESS_TOKEN_MINUTES=15
FAMILY_API_REFRESH_TOKEN_DAYS=30
FAMILY_API_CORS_ORIGINS=
# Comma-separated parent emails that may call the API during development.
# Leave empty to allow all in development; production ignores this allow-list.
